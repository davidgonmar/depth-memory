{
  "architectures": [
    "Qwen3ForCausalLM"
  ],
  "hidden_size": 2048,
  "num_hidden_layers": 28,
  "num_attention_heads": 16,
  "num_key_value_heads": 8,
  "head_dim": 128,
  "intermediate_size": 6144,
  "qk_norm": true,
  "use_head_qk_norm": true,
  "hidden_act": "silu",
  "rms_norm_eps": 1e-06,
  "rope_theta": 1000000,
  "max_sequence_length": 2048,
  "vocab_size": 151936,
  "tie_word_embeddings": true,
  "attention_bias": false,
  "torch_dtype": "bfloat16",
  "block_name": "ldm",
  "ldm": {
    "quality": {
      "key_dim": 8,
      "groups": 16,
      "addresses": {
        "hidden_dim": 64,
        "query": {
          "mode": "dynamic",
          "source": "current_stream"
        },
        "key": {
          "mode": "dynamic",
          "source": "updated_stream"
        },
        "normalize_query": true,
        "normalize_key": true
      },
      "value_source": "branch_delta",
      "rls": {
        "alpha_init": 1.0,
        "lambda_init": 0.99,
        "learn_lambda": true
      },
      "read_gate": {
        "enabled": true,
        "initial_gain": 1.0
      },
      "write_gate": {
        "enabled": true,
        "initial_gain": 1.0
      },
      "learned_read_gain": {
        "enabled": true,
        "initial_gain": 1.0
      },
      "replace_read": false,
      "no_post_function_residual": false,
      "eps": 1e-06
    }
  }
}
