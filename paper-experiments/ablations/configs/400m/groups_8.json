{
  "architectures": [
    "LLaMAForCausalLM"
  ],
  "attention_bias": false,
  "bos_token_id": null,
  "eos_token_id": 50279,
  "head_dim": 64,
  "hidden_act": "silu",
  "hidden_size": 1024,
  "intermediate_size": 2736,
  "initializer_range": 0.02,
  "max_sequence_length": 2048,
  "model_type": "llama",
  "num_hidden_layers": 24,
  "num_attention_heads": 16,
  "num_key_value_heads": 16,
  "pad_token_id": 1,
  "rope_theta": 10000,
  "rms_norm_eps": 1e-06,
  "tie_word_embeddings": false,
  "torch_dtype": "bfloat16",
  "transformers_version": "4.28.1",
  "use_cache": true,
  "vocab_size": 50280,
  "block_name": "ldm",
  "ldm": {
    "quality": {
      "key_dim": 8,
      "recurrence": "rls",
      "groups": 8,
      "addresses": {
        "hidden_dim": 32,
        "query": {
          "mode": "dynamic",
          "source": "current_stream"
        },
        "key": {
          "mode": "dynamic",
          "source": "updated_stream"
        },
        "normalize_query": true,
        "normalize_key": true
      },
      "value_source": "branch_delta",
      "rls": {
        "alpha_init": 1.0,
        "lambda_init": 0.99,
        "learn_lambda": true,
        "learn_alpha": false,
        "ridge_min": 0.25
      },
      "read_gate": {
        "enabled": true,
        "initial_gain": 1.0
      },
      "write_gate": {
        "enabled": true,
        "initial_gain": 1.0
      },
      "learned_read_gain": {
        "enabled": true,
        "initial_gain": 1.0
      },
      "replace_read": false,
      "no_post_function_residual": false,
      "eps": 1e-06
    }
  }
}
